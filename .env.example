# Copy to .env and fill in locally. Never commit .env or API keys.

# --- Anthropic API (optional) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Vertex AI on Google Cloud (optional alternative) ---
# Uses Application Default Credentials, not a key file in this repo.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# VERTEX_MODEL=gemini-2.5-flash

# Default provider if --provider is omitted: auto
# (anthropic if ANTHROPIC_API_KEY is set, else vertex if GOOGLE_CLOUD_PROJECT is set, else template)
# SCOPER_PROVIDER=auto
